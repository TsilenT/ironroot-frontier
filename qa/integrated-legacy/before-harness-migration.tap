im();\n  padHud = false;\n  padPoint = { x: renderer.width / 2, y: renderer.height / 2 };\n  started = true;\n  paused = false;\n  speed = 1;\n  resultShown = false;\n  follow = false;\n  objectiveOutcome = null;\n  heardEffects = new WeakSet();\n  heardProjectiles = new WeakSet();\n  renderer.vfx?.reset();\n  cancel();\n  $('welcome').classList.add('hidden');\n  $('resultModal').classList.add('hidden');\n  $('pauseVeil').classList.add('hidden');\n  const mission =\n    currentCampaign && CAMPAIGN_MISSIONS.find((m) => m.id === currentCampaign);\n  if (mission) {\n    mode = 'campaign';\n    selectedCampaign = mission.id;\n    selectedChapter = mission.chapterId;\n  } else if (currentChallenge) {\n    mode = 'challenges';\n    selectedChallenge = currentChallenge;\n  } else mode = 'skirmish';\n  $('matchType').textContent = currentCampaign\n    ? 'CAMPAIGN'\n    : currentChallenge\n      ? 'FIELD TRIAL'\n      : 'SOLO SKIRMISH';\n  $('opponentLabel').textContent = mission\n    ? mission.name.toUpperCase()\n    : currentChallenge\n      ? CHALLENGES.find((c) => c.id === currentChallenge).name.toUpperCase()\n      : {\n          easy: 'THE OUTRIDER',\n          normal: 'THE IRON MARSHAL',\n          hard: 'THE WARLORD',\n        }[difficulty];\n  renderer.setMap(game.map);\n  renderer.setTheme?.(\n    mission\n      ? CAMPAIGN_CHAPTERS.find((c) => c.id === mission.chapterId).theme\n      : 'woodland',\n  );\n  $('speed').textContent = '1×';\n  pauseControl();\n  $('pause').onclick = () => pause(!paused, { explicit: true });\n  renderer.camera = restored ? game.state.frontline : 450;\n  renderer.clampCamera();\n  initAudio();\n  sound('build');\n  $('toast').classList.remove('show');\n  if (!mission || !coachEnabled || !campaignCoach(game, mission.id, ui)) toast(\n    restored\n      ? 'Battle resumed.'\n      : mission\n        ? mission.objective\n        : currentChallenge\n          ? CHALLENGES.find((c) => c.id === currentChallenge).objective\n          : 'Choose a building, then tap a green slot to place it.',\n  );\n  $('battle').focus();\n  // Reveal and populate the real HUD before measuring its target controls.\n  updateHUD();\n  syncViewportSafety();\n  if (game.limitReason) holdBattleSafety(game.limitReason);\n  save();\n}\n",
    expected: /started = true;[\s\S]*syncViewportSafety\(\);\s*save\(\);/,
    operator: 'match',
    diff: 'simple'
  }

