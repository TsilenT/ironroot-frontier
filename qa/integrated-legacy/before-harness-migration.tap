    '      pointer.lastX = x;\n' +
    '      return { pan, dragging:pointer.moved };\n' +
    '    },\n' +
    '    end(id, x, y) {\n' +
    '      contacts.delete(id);\n' +
    '      if (multiple) {\n' +
    '        if (!contacts.size) multiple = false;\n' +
    '        pointer = null;\n' +
    '        return false;\n' +
    '      }\n' +
    '      if (!pointer || pointer.id !== id) return false;\n' +
    '      const tap = !pointer.moved && Math.hypot(x - pointer.x, y - pointer.y) <= threshold;\n' +
    '      pointer = null;\n' +
    '      return tap;\n' +
    '    },\n' +
    '    cancel(id) {\n' +
    '      if (id === undefined) { contacts.clear(); multiple = false; pointer = null; return; }\n' +
    '      contacts.delete(id);\n' +
    '      if (!contacts.size) multiple = false;\n' +
    '      if (pointer?.id === id) pointer = null;\n' +
    '    },\n' +
    '  };\n' +
