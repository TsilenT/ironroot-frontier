    '\n' +
    '/** Independent of DOM: a drag, a second contact or lost capture can never place. */\n' +
    'export function createTrainingGesture(threshold = 8) {\n' +
    '  let pointer = null;\n' +
    '  const contacts = new Set();\n' +
    '  let multiple = false;\n' +
    '  return {\n' +
    '    start(id, x, y) {\n' +
    '      contacts.add(id);\n' +
    '      if (contacts.size > 1) { multiple = true; pointer = null; return false; }\n' +
