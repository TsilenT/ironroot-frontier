--- dist/styles.css
+++ dist/styles.css
@@ -3137,3 +3138,34 @@
   .result-stats, .campaign-result .result-stats {margin: 14px 0;}
 }
 
+/* Campaign hints live in the same command deck as every real build action. */
+.campaign-coach {
+  display: flex;
+  align-items: baseline;
+  gap: 12px;
+  border-left: 3px solid var(--gold);
+  padding: 5px 10px;
+  margin-bottom: 8px;
+  color: #e1e6d3;
+  font-size: 12px;
+  line-height: 1.4;
+}
+.campaign-coach b {color: #f3d895; flex-shrink: 0;}
+.deck-tools {display: flex; gap: 10px; margin: -4px 0 8px;}
+.deck-tools:has(> .hidden:only-child), .deck-tools:has(> .hidden + .hidden) {display: none;}
+.deck-tools button {
+  background: #25352b;
+  color: #e9d49e;
+  border: 1px solid #6f7550;
+  padding: 7px 10px;
+  min-height: 36px;
+  font-size: 11px;
+}
+.coach-highlight {box-shadow: inset 0 0 0 2px #ffe2a0, 0 0 0 1px #ffe2a0;}
+@media(max-width:700px), (max-height:500px) {
+  .campaign-coach {display: block; font-size: 10px; margin: 0 13px 6px; padding: 3px 8px;}
+  .campaign-coach b {margin-right: 7px;}
+  .deck-tools {margin: 0 13px 6px; gap: 8px;}
+  .deck-tools button {min-height: 36px; padding: 4px 9px; font-size: 10px;}
+}
+
